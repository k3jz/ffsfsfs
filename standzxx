--// Roblox Lua Script - Polished GUI with Dragging, Rounded Corners

-- Services
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Variables
local keybind = Enum.KeyCode.E -- Default movement key
local moveDistance = 5 -- Default distance
local guiVisible = true -- GUI starts visible
local toggleKey = Enum.KeyCode.Insert -- Key to toggle GUI

-- GUI Setup
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "CFrameMoverGui"

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 250, 0, 170)
frame.Position = UDim2.new(0.5, -125, 0.5, -85)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner", frame)
corner.CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "CFrame Mover Settings"
title.Font = Enum.Font.GothamBold
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 18

local keybindBox = Instance.new("TextBox", frame)
keybindBox.Size = UDim2.new(0, 200, 0, 30)
keybindBox.Position = UDim2.new(0, 25, 0, 40)
keybindBox.PlaceholderText = "Enter Key (example: E)"
keybindBox.Font = Enum.Font.Gotham
keybindBox.TextColor3 = Color3.new(1,1,1)
keybindBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
keybindBox.Text = ""

local distanceBox = Instance.new("TextBox", frame)
distanceBox.Size = UDim2.new(0, 200, 0, 30)
distanceBox.Position = UDim2.new(0, 25, 0, 80)
distanceBox.PlaceholderText = "Enter Distance (example: 5)"
distanceBox.Font = Enum.Font.Gotham
distanceBox.TextColor3 = Color3.new(1,1,1)
distanceBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
distanceBox.Text = ""

local applyButton = Instance.new("TextButton", frame)
applyButton.Size = UDim2.new(0, 200, 0, 30)
applyButton.Position = UDim2.new(0, 25, 0, 120)
applyButton.Text = "Apply Settings"
applyButton.Font = Enum.Font.GothamBold
applyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
applyButton.BackgroundColor3 = Color3.fromRGB(70, 130, 70)

local buttonCorner = Instance.new("UICorner", applyButton)
buttonCorner.CornerRadius = UDim.new(0, 8)

-- Function to apply settings
local function applySettings()
    local inputKey = keybindBox.Text:upper()
    if Enum.KeyCode[inputKey] then
        keybind = Enum.KeyCode[inputKey]
    end

    local distance = tonumber(distanceBox.Text)
    if distance then
        moveDistance = distance
    end
end

applyButton.MouseButton1Click:Connect(applySettings)

-- Input Handler
local function onInput(input, gameProcessed)
    if gameProcessed then return end

    -- Toggle GUI
    if input.KeyCode == toggleKey then
        guiVisible = not guiVisible
        frame.Visible = guiVisible
        return
    end

    -- Move player
    if input.KeyCode == keybind then
        humanoidRootPart.CFrame = humanoidRootPart.CFrame * CFrame.new(0, 0, -moveDistance)
    end
end

UserInputService.InputBegan:Connect(onInput)
